<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>QueryAI - Login</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;

            background:
                radial-gradient(
                    circle at top left,
                    #312e81 0%,
                    transparent 35%
                ),
                radial-gradient(
                    circle at bottom right,
                    #4c1d95 0%,
                    transparent 35%
                ),
                #020617;

            color: #ffffff;
        }

        .container {
            width: 100%;
            max-width: 420px;

            padding: 35px;

            background: rgba(15, 23, 42, 0.88);

            border: 1px solid rgba(255, 255, 255, 0.1);

            border-radius: 18px;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.45);

            backdrop-filter: blur(12px);
        }

        .logo {
            text-align: center;

            font-size: 29px;
            font-weight: 700;

            color: #a78bfa;

            margin-bottom: 8px;
        }

        .title {
            text-align: center;

            font-size: 24px;

            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;

            color: #94a3b8;

            font-size: 14px;

            line-height: 1.5;

            margin-bottom: 28px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;

            margin-bottom: 8px;

            color: #cbd5e1;

            font-size: 14px;

            font-weight: 600;
        }

        input {
            width: 100%;

            padding: 13px 14px;

            border-radius: 9px;

            border: 1px solid #334155;

            background: #020617;

            color: #ffffff;

            outline: none;

            font-size: 15px;

            transition:
                border-color 0.2s,
                box-shadow 0.2s;
        }

        input::placeholder {
            color: #64748b;
        }

        input:focus {
            border-color: #8b5cf6;

            box-shadow:
                0 0 0 3px rgba(139, 92, 246, 0.15);
        }

        .login-btn {
            width: 100%;

            padding: 13px;

            margin-top: 5px;

            border: none;

            border-radius: 9px;

            background: linear-gradient(
                135deg,
                #7c3aed,
                #8b5cf6
            );

            color: white;

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;

            transition:
                transform 0.2s,
                opacity 0.2s;
        }

        .login-btn:hover {
            transform: translateY(-1px);
            opacity: 0.92;
        }

        .login-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        #message {
            display: none;

            margin-top: 16px;

            padding: 11px 13px;

            border-radius: 8px;

            font-size: 14px;

            line-height: 1.4;
        }

        #message.error {
            display: block;

            color: #fca5a5;

            background: rgba(239, 68, 68, 0.12);

            border: 1px solid rgba(239, 68, 68, 0.35);
        }

        #message.success {
            display: block;

            color: #86efac;

            background: rgba(34, 197, 94, 0.12);

            border: 1px solid rgba(34, 197, 94, 0.35);
        }

        #message.loading {
            display: block;

            color: #c4b5fd;

            background: rgba(139, 92, 246, 0.12);

            border: 1px solid rgba(139, 92, 246, 0.3);
        }

        .signup-text {
            margin-top: 22px;

            text-align: center;

            color: #94a3b8;

            font-size: 14px;
        }

        .signup-text a {
            color: #a78bfa;

            text-decoration: none;

            font-weight: 600;
        }

        .signup-text a:hover {
            color: #c4b5fd;
        }

        .footer-text {
            margin-top: 24px;

            text-align: center;

            color: #475569;

            font-size: 12px;
        }

        @media (max-width: 480px) {

            body {
                padding: 15px;
            }

            .container {
                padding: 28px 22px;
            }

            .title {
                font-size: 21px;
            }
        }
    </style>
</head>


<body>

    <div class="container">

        <div class="logo">
            QueryAI
        </div>

        <h1 class="title">
            Welcome Back
        </h1>

        <p class="subtitle">
            Login to your QueryAI dashboard and
            interact with your database using natural language.
        </p>


        <form id="loginForm">

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    placeholder="you@example.com"
                    required
                >

            </div>


            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    placeholder="Enter your password"
                    required
                >

            </div>


            <button
                type="submit"
                class="login-btn"
                id="loginButton">

                Login

            </button>

        </form>


        <p id="message"></p>


        <p class="signup-text">

            Don't have an account?

            <a href="/signup">
                Create one
            </a>

        </p>


        <p class="footer-text">
            QueryAI · Natural Language Database Analytics
        </p>

    </div>


    <script>

        document
            .getElementById("loginForm")
            .addEventListener("submit", async (e) => {

                e.preventDefault();


                const email =
                    document.getElementById("email").value;

                const password =
                    document.getElementById("password").value;

                const message =
                    document.getElementById("message");

                const button =
                    document.getElementById("loginButton");


                /* Loading */

                message.className = "loading";

                message.textContent =
                    "Logging in...";

                button.disabled = true;

                button.textContent =
                    "Logging in...";


                try {

                    const response =
                        await fetch("/login", {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                email,
                                password
                            })

                        });


                    const data =
                        await response.json();


                    if (!response.ok) {

                        throw new Error(
                            data.message ||
                            "Login failed"
                        );

                    }


                    message.className =
                        "success";

                    message.textContent =
                        "Login successful ✓";


                    setTimeout(() => {

                        window.location.href =
                            "/dashboard";

                    }, 500);


                } catch (error) {

                    message.className =
                        "error";

                    message.textContent =
                        error.message ||
                        "Invalid email or password.";


                    button.disabled = false;

                    button.textContent =
                        "Login";

                }

            });

    </script>

</body>

</html>