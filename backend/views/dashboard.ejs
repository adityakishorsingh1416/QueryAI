<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>QueryAI Dashboard</title>


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        body {
            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #0f172a,
                    #1e1b4b,
                    #312e81
                );

            color: #ffffff;
        }


        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            height: 70px;

            padding: 0 30px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            background:
                rgba(15, 23, 42, 0.85);

            border-bottom:
                1px solid rgba(255, 255, 255, 0.1);

            backdrop-filter: blur(10px);
        }


        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #a78bfa;
        }


        .nav-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }


        .status {
            display: flex;
            align-items: center;
            gap: 8px;

            font-size: 14px;
            color: #cbd5e1;
        }


        .status-dot {
            width: 9px;
            height: 9px;

            background: #22c55e;

            border-radius: 50%;
        }


        .logout-btn,
        .connect-btn {
            padding: 9px 16px;

            border-radius: 8px;

            color: white;

            font-weight: 600;

            cursor: pointer;
        }


        .logout-btn {
            border: none;

            background: #ef4444;
        }


        .logout-btn:hover {
            background: #dc2626;
        }


        .connect-btn {
            background: #7c3aed;

            text-decoration: none;
        }


        .connect-btn:hover {
            background: #6d28d9;
        }


        /* =========================
           MAIN LAYOUT
        ========================= */

        .container {
            display: flex;

            min-height:
                calc(100vh - 70px);
        }


        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            width: 270px;

            padding: 25px;

            background:
                rgba(15, 23, 42, 0.75);

            border-right:
                1px solid rgba(255, 255, 255, 0.08);
        }


        .sidebar h3 {
            margin-bottom: 20px;

            color: #c4b5fd;
        }


        .schema-collection {
            margin-bottom: 18px;
        }


        .collection-name {
            font-weight: bold;

            color: #a78bfa;

            margin-bottom: 8px;
        }


        .field {
            padding: 5px 0;

            color: #cbd5e1;

            font-size: 14px;
        }


        .field-type {
            color: #64748b;

            margin-left: 5px;
        }


        /* =========================
           MAIN CONTENT
        ========================= */

        .main {
            flex: 1;

            padding: 30px;

            overflow-y: auto;
        }


        .page-title {
            margin-bottom: 8px;

            font-size: 30px;
        }


        .page-subtitle {
            color: #94a3b8;

            margin-bottom: 30px;
        }


        /* =========================
           CARDS
        ========================= */

        .card {
            background:
                rgba(15, 23, 42, 0.72);

            border:
                1px solid rgba(255, 255, 255, 0.08);

            border-radius: 14px;

            padding: 25px;

            margin-bottom: 25px;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.2);
        }


        .card h2 {
            margin-bottom: 15px;

            font-size: 20px;
        }


        /* =========================
           QUERY INPUT
        ========================= */

        textarea {
            width: 100%;

            min-height: 120px;

            padding: 15px;

            border-radius: 10px;

            border:
                1px solid #334155;

            background: #020617;

            color: #ffffff;

            resize: vertical;

            outline: none;

            font-size: 15px;
        }


        textarea:focus {
            border-color: #8b5cf6;
        }


        .query-btn {
            margin-top: 15px;

            padding: 11px 22px;

            border: none;

            border-radius: 8px;

            background: #7c3aed;

            color: white;

            font-weight: bold;

            cursor: pointer;
        }


        .query-btn:hover {
            background: #6d28d9;
        }


        .query-btn:disabled {
            opacity: 0.6;

            cursor: not-allowed;
        }


        /* =========================
           GENERATED QUERY
        ========================= */

        .query-box {
            background: #020617;

            border:
                1px solid #334155;

            padding: 15px;

            border-radius: 10px;

            overflow-x: auto;

            color: #a5f3fc;

            white-space: pre-wrap;

            font-family:
                Consolas,
                Monaco,
                monospace;

            font-size: 14px;
        }


        /* =========================
           RESULTS
        ========================= */

        .table-wrapper {
            overflow-x: auto;
        }


        table {
            width: 100%;

            border-collapse: collapse;

            margin-top: 10px;
        }


        th,
        td {
            padding: 12px;

            border-bottom:
                1px solid #334155;

            text-align: left;
        }


        th {
            background: #1e293b;

            color: #c4b5fd;
        }


        td {
            color: #cbd5e1;
        }


        /* =========================
           HISTORY
        ========================= */

        .history-item {
            padding: 15px;

            margin-bottom: 12px;

            background: #020617;

            border:
                1px solid #334155;

            border-radius: 10px;

            cursor: pointer;
        }


        .history-item:hover {
            border-color: #8b5cf6;
        }


        .history-question {
            color: #ffffff;

            font-weight: 600;

            margin-bottom: 8px;
        }


        .history-query {
            color: #94a3b8;

            font-size: 13px;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;
        }


        .history-date {
            margin-top: 8px;

            font-size: 12px;

            color: #64748b;
        }


        /* =========================
           MESSAGES
        ========================= */

        .message {
            padding: 12px 15px;

            border-radius: 8px;

            margin-top: 15px;

            display: none;
        }


        .error {
            background:
                rgba(239, 68, 68, 0.15);

            border:
                1px solid #ef4444;

            color: #fca5a5;
        }


        .success {
            background:
                rgba(34, 197, 94, 0.15);

            border:
                1px solid #22c55e;

            color: #86efac;
        }


        .empty {
            color: #64748b;

            padding: 10px 0;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 800px) {

            .container {
                flex-direction: column;
            }


            .sidebar {
                width: 100%;

                border-right: none;

                border-bottom:
                    1px solid
                    rgba(255, 255, 255, 0.08);
            }


            .main {
                padding: 20px;
            }


            .navbar {
                padding: 0 15px;
            }


            .status {
                display: none;
            }

        }

    </style>

</head>


<body>


    <!-- =========================
         NAVBAR
    ========================= -->

    <nav class="navbar">

        <div class="logo">
            QueryAI
        </div>


        <div class="nav-right">

            <a
                href="/connect-db"
                class="connect-btn"
            >
                Connect Database
            </a>


            <div class="status">

                <span
                    id="statusDot"
                    class="status-dot"
                ></span>

                <span id="databaseStatus">
                    Checking...
                </span>

            </div>


            <button
                onclick="logout()"
                class="logout-btn"
            >
                Logout
            </button>

        </div>

    </nav>


    <!-- =========================
         MAIN LAYOUT
    ========================= -->

    <div class="container">


        <!-- SIDEBAR -->

        <aside class="sidebar">

            <h3>
                MongoDB Schema
            </h3>


            <div id="schema">

                <p class="empty">
                    Loading schema...
                </p>

            </div>

        </aside>


        <!-- MAIN CONTENT -->

        <main class="main">


            <h1 class="page-title">
                Query Dashboard
            </h1>


            <p class="page-subtitle">
                Ask questions about your MongoDB database using natural language.
            </p>


            <!-- QUERY CARD -->

            <section class="card">

                <h2>
                    Ask Your Database
                </h2>


                <textarea
                    id="question"
                    placeholder="Example: Give me the names of all employees in the IT department"
                ></textarea>


                <button
                    id="queryBtn"
                    class="query-btn"
                    onclick="runQuery()"
                >
                    Generate & Run Query
                </button>


                <div
                    id="message"
                    class="message"
                ></div>

            </section>


            <!-- GENERATED QUERY -->

            <section class="card">

                <h2>
                    Generated MongoDB Query
                </h2>


                <div
                    id="query"
                    class="query-box"
                >
                    MongoDB query will appear here.
                </div>

            </section>


            <!-- QUERY RESULTS -->

            <section class="card">

                <h2>
                    Query Results
                </h2>


                <div
                    id="results"
                    class="table-wrapper"
                >

                    <p class="empty">
                        Query results will appear here.
                    </p>

                </div>

            </section>


            <!-- QUERY HISTORY -->

            <section class="card">

                <h2>
                    Recent Queries
                </h2>


                <div id="history">

                    <p class="empty">
                        Loading history...
                    </p>

                </div>

            </section>


        </main>

    </div>


    <script>


        /* =========================
           LOAD DATABASE SCHEMA
        ========================= */

        async function loadSchema() {

            const schemaContainer =
                document.getElementById("schema");


            try {

                const response =
                    await fetch("/schema");


                if (!response.ok) {

                    throw new Error(
                        "Could not load schema"
                    );

                }


                const schema =
                    await response.json();


                schemaContainer.innerHTML = "";


                const collections =
                    Object.keys(schema);


                if (collections.length === 0) {

                    schemaContainer.innerHTML =
                        '<p class="empty">No collections found.</p>';

                    return;

                }


                collections.forEach(
                    collectionName => {

                        const collectionDiv =
                            document.createElement(
                                "div"
                            );


                        collectionDiv.className =
                            "schema-collection";


                        let html = `

                            <div class="collection-name">
                                ${escapeHtml(collectionName)}
                            </div>

                        `;


                        schema[collectionName]
                            .forEach(field => {

                                html += `

                                    <div class="field">

                                        ${escapeHtml(
                                            field.field
                                        )}

                                        <span
                                            class="field-type"
                                        >
                                            (${escapeHtml(
                                                field.type
                                            )})
                                        </span>

                                    </div>

                                `;

                            });


                        collectionDiv.innerHTML =
                            html;


                        schemaContainer.appendChild(
                            collectionDiv
                        );

                    }
                );


            } catch (error) {

                schemaContainer.innerHTML = `

                    <p class="empty">
                        Could not load schema.
                    </p>

                `;

            }

        }


        /* =========================
           RUN NATURAL LANGUAGE QUERY
        ========================= */

        async function runQuery() {

            const questionInput =
                document.getElementById(
                    "question"
                );


            const queryButton =
                document.getElementById(
                    "queryBtn"
                );


            const message =
                document.getElementById(
                    "message"
                );


            const queryContainer =
                document.getElementById(
                    "query"
                );


            const resultsContainer =
                document.getElementById(
                    "results"
                );


            const question =
                questionInput.value.trim();


            if (!question) {

                showMessage(
                    "Please enter a question.",
                    "error"
                );

                return;

            }


            queryButton.disabled = true;

            queryButton.innerText =
                "Generating Query...";


            message.style.display =
                "none";


            try {

                const response =
                    await fetch(
                        "/query",
                        {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify({
                                    question
                                })

                        }
                    );


                const data =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        data.message ||
                        "Query failed"
                    );

                }


                /* Generated MongoDB query */

                queryContainer.textContent =
                    JSON.stringify(
                        data.query,
                        null,
                        2
                    );


                /* Results */

                displayResults(
                    data.result
                );


                /* Success */

                showMessage(
                    "Query executed successfully.",
                    "success"
                );


                /* Refresh history */

                loadHistory();


            } catch (error) {

                queryContainer.textContent =
                    "No MongoDB query generated.";


                resultsContainer.innerHTML = `

                    <p class="empty">
                        No results available.
                    </p>

                `;


                showMessage(
                    error.message,
                    "error"
                );


            } finally {

                queryButton.disabled = false;

                queryButton.innerText =
                    "Generate & Run Query";

            }

        }


        /* =========================
           DISPLAY RESULTS
        ========================= */

        function displayResults(rows) {

            const container =
                document.getElementById(
                    "results"
                );


            if (
                !rows ||
                rows.length === 0
            ) {

                container.innerHTML = `

                    <p class="empty">
                        Query returned no results.
                    </p>

                `;

                return;

            }


            const columns =
                Object.keys(rows[0]);


            let html =
                "<table>";


            /* TABLE HEADER */

            html +=
                "<thead><tr>";


            columns.forEach(column => {

                html += `

                    <th>
                        ${escapeHtml(column)}
                    </th>

                `;

            });


            html +=
                "</tr></thead>";


            /* TABLE BODY */

            html +=
                "<tbody>";


            rows.forEach(row => {

                html +=
                    "<tr>";


                columns.forEach(column => {

                    let value =
                        row[column];


                    /*
                     * MongoDB ObjectId,
                     * Date and nested objects
                     * need readable formatting.
                     */

                    if (
                        value !== null &&
                        typeof value === "object"
                    ) {

                        value =
                            JSON.stringify(
                                value
                            );

                    }


                    html += `

                        <td>
                            ${escapeHtml(
                                value ?? ""
                            )}
                        </td>

                    `;

                });


                html +=
                    "</tr>";

            });


            html +=
                "</tbody>";


            html +=
                "</table>";


            container.innerHTML =
                html;

        }


        /* =========================
           LOAD QUERY HISTORY
        ========================= */

        async function loadHistory() {

            const container =
                document.getElementById(
                    "history"
                );


            try {

                const response =
                    await fetch(
                        "/query-history"
                    );


                if (!response.ok) {

                    throw new Error(
                        "Could not load history"
                    );

                }


                const history =
                    await response.json();


                displayHistory(
                    history
                );


            } catch (error) {

                container.innerHTML = `

                    <p class="empty">
                        Could not load query history.
                    </p>

                `;

            }

        }


        /* =========================
           DISPLAY QUERY HISTORY
        ========================= */

        function displayHistory(history) {

            const container =
                document.getElementById(
                    "history"
                );


            if (
                !history ||
                history.length === 0
            ) {

                container.innerHTML = `

                    <p class="empty">
                        No queries yet.
                    </p>

                `;

                return;

            }


            container.innerHTML =
                "";


            history.forEach(item => {

                const historyItem =
                    document.createElement(
                        "div"
                    );


                historyItem.className =
                    "history-item";


                const queryText =
                    JSON.stringify(
                        item.query
                    );


                historyItem.innerHTML = `

                    <div class="history-question">
                        ${escapeHtml(
                            item.question
                        )}
                    </div>


                    <div class="history-query">
                        ${escapeHtml(
                            queryText
                        )}
                    </div>


                    <div class="history-date">
                        ${new Date(
                            item.createdAt
                        ).toLocaleString()}
                    </div>

                `;


                /*
                 * Clicking history puts
                 * the question back into
                 * the query box.
                 */

                historyItem.addEventListener(
                    "click",
                    () => {

                        document.getElementById(
                            "question"
                        ).value =
                            item.question;


                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });

                    }
                );


                container.appendChild(
                    historyItem
                );

            });

        }


        /* =========================
           HTML ESCAPE
        ========================= */

        function escapeHtml(value) {

            return String(value)
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }


        /* =========================
           MESSAGE
        ========================= */

        function showMessage(
            text,
            type
        ) {

            const message =
                document.getElementById(
                    "message"
                );


            message.innerText =
                text;


            message.className =
                `message ${type}`;


            message.style.display =
                "block";

        }


        /* =========================
           LOGOUT
        ========================= */

        async function logout() {

            try {

                const response =
                    await fetch(
                        "/logout",
                        {
                            method: "POST"
                        }
                    );


                if (response.ok) {

                    window.location.href =
                        "/login";

                } else {

                    alert(
                        "Logout failed."
                    );

                }

            } catch (error) {

                console.error(error);

                alert(
                    "Logout failed."
                );

            }

        }


        /* =========================
           DATABASE STATUS
        ========================= */

        async function checkDatabaseStatus() {

            const statusText =
                document.getElementById(
                    "databaseStatus"
                );


            const statusDot =
                document.getElementById(
                    "statusDot"
                );


            try {

                const response =
                    await fetch(
                        "/database-status"
                    );


                const data =
                    await response.json();


                if (data.connected) {

                    statusText.innerText =
                        "Database Connected";


                    statusDot.style.background =
                        "#22c55e";

                } else {

                    statusText.innerText =
                        "Database Not Connected";


                    statusDot.style.background =
                        "#ef4444";

                }


            } catch (error) {

                statusText.innerText =
                    "Database Not Connected";


                statusDot.style.background =
                    "#ef4444";

            }

        }


        /* =========================
           INITIAL LOAD
        ========================= */

        checkDatabaseStatus();

        loadSchema();

        loadHistory();

    </script>


</body>

</html>